# Postgres local ou Neon (no Neon use a connection string com ?sslmode=require)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amigo-secreto

# Endereço público do app (produção: https://amigo-secreto.anselmotech.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails pelo Resend. Sem a chave, os e-mails (inclusive o link de login) aparecem só no terminal.
RESEND_API_KEY=
EMAIL_FROM="Amigo Secreto <nao-responda@anselmotech.com.br>"

# Cifra os links individuais guardados no banco. Gere com: openssl rand -base64 32
# Se faltar, o app usa o CRON_SECRET. Não troque depois de ir ao ar: os links salvos deixam de poder ser reenviados.
APP_SECRET=

# Protege a rota de lembretes diários (a Vercel envia automaticamente)
CRON_SECRET=

# WhatsApp pela Evolution API (opcional; sem isso as mensagens só aparecem no terminal)
EVOLUTION_API_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
