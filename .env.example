# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor. Nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app (usado nos links de e-mail e convite)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails pelo Resend (opcional; sem a chave, os e-mails só aparecem no log)
RESEND_API_KEY=
EMAIL_FROM="Amigo Secreto <nao-responda@seudominio.com.br>"

# Protege a rota de lembretes diários (a Vercel envia automaticamente)
CRON_SECRET=
